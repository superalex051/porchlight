<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.alexluncan.PorchLight.guardian</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.alexluncan.PorchLight</string>
	</array>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/PorchLight.app/Contents/Helpers/porchlight-guardian</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/PorchLight/guardian.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/PorchLight/guardian.log</string>
</dict>
</plist>
