#!/bin/bash
# The installer runs this as root after /Applications/PorchLight.app is in place. For the logged-in user it
# starts the guardian LaunchAgent (the same one Scripts/install.sh --guardian installs), links the CLI, and
# opens Porch Light. guardian.plist is Config/com.alexluncan.PorchLight.guardian.plist, put next to this
# script by Scripts/release.sh.

LABEL=com.alexluncan.PorchLight.guardian
CLI=/Applications/PorchLight.app/Contents/Helpers/porchlight

user="$(stat -f %Su /dev/console)"
if [ -z "$user" ] || [ "$user" = root ]; then
    echo "No one is logged in, so the guardian wasn't started. Run the installer again from your account."
    exit 0
fi
uid="$(id -u "$user")"
group="$(id -gn "$user")"
home="$(dscl . -read "/Users/$user" NFSHomeDirectory | awk '{print $2}')"
[ -d "$home" ] || { echo "Couldn't find the home folder of $user." >&2; exit 1; }

as_user() {
    launchctl asuser "$uid" sudo -u "$user" "$@"
}

# The guardian: its LaunchAgent plist, with the user's home in the log paths, then loaded in their session.
agent="$home/Library/LaunchAgents/$LABEL.plist"
sudo -u "$user" mkdir -p "$home/Library/LaunchAgents" "$home/Library/Logs/PorchLight"
home_for_sed="$(printf '%s' "$home" | sed 's/[&|\\]/\\&/g')"
sed "s|__HOME__|$home_for_sed|g" "$(dirname "$0")/guardian.plist" > "$agent"
chown "$user:$group" "$agent"
chmod 644 "$agent"
plutil -lint -s "$agent" || { echo "The guardian's LaunchAgent plist isn't valid." >&2; exit 1; }
launchctl bootout "gui/$uid/$LABEL" 2>/dev/null || true
started=false
for _ in 1 2 3 4 5; do
    if launchctl bootstrap "gui/$uid" "$agent" 2>/dev/null; then started=true; break; fi
    sleep 1
done
$started || { echo "The guardian didn't start. Log out and back in, or run: launchctl bootstrap gui/$uid $agent" >&2; exit 1; }

# The CLI: on the PATH, and in ~/.local/bin, where the Parsec scripts look for it.
mkdir -p /usr/local/bin
ln -sf "$CLI" /usr/local/bin/porchlight
sudo -u "$user" mkdir -p "$home/.local/bin"
sudo -u "$user" ln -sf "$CLI" "$home/.local/bin/porchlight"

as_user open -a /Applications/PorchLight.app || true
exit 0
