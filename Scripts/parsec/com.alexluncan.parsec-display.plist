<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs parsec-display-watch at login and keeps it running. HOME_DIR is replaced with your home folder
     when it is installed: see "Use it with Parsec" in the README. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.alexluncan.parsec-display</string>
  <key>ProgramArguments</key><array><string>HOME_DIR/.local/bin/parsec-display-watch</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>HOME_DIR/Library/Logs/parsec-display.log</string>
  <key>StandardErrorPath</key><string>HOME_DIR/Library/Logs/parsec-display.log</string>
</dict></plist>
